# Homebrew formula scaffold for any product distributed via the
# simtabi/homebrew-tap on GitHub.
#
# This file is a SCAFFOLD, not a working formula. After the first PyPI
# release, generate the live formula automatically:
#
#   1. Create simtabi/homebrew-tap on GitHub (empty repo with Formula/ dir).
#   2. In a fresh checkout of the tap:
#        brew tap-new simtabi/tap
#        brew create --python --tap simtabi/tap \
#          https://files.pythonhosted.org/packages/source/{first}/{package}/{package}-{X.Y.Z}.tar.gz
#        brew update-python-resources Formula/{package}.rb
#        brew style --fix Formula/{package}.rb
#        brew audit --new --strict Formula/{package}.rb
#
# `brew create --python` writes a stanza very similar to this template
# but with the correct sha256 hashes. `brew update-python-resources`
# walks pyproject.toml's [project.dependencies] and emits a `resource`
# block per package with its sdist URL and sha256.
#
# Once the tap exists, a release-time workflow step keeps the formula's
# url + sha256 in sync on every release (see docs/distribution/homebrew.md).
#
# Placeholders to fill before running through `brew audit`:
#   {ClassName}          PascalCase of the product (e.g. "ClaudeConfigurator")
#   {description}        ≤ 80 chars, no trailing period
#   {homepage}           Product landing page on the OSS portal
#   {github_repo}        e.g. "simtabi/claude-configurator"
#   {package}            PyPI distribution name (lowercase, hyphens)
#   {first}              first character of {package}
#   {X.Y.Z}              the version being shipped
#   {entrypoint}         CLI entry point name (often == {package})

class {ClassName} < Formula
  include Language::Python::Virtualenv

  desc "{description}"
  homepage "{homepage}"
  url "https://files.pythonhosted.org/packages/source/{first}/{package}/{package}-{X.Y.Z}.tar.gz"
  sha256 "PLACEHOLDER_SDIST_SHA256"
  license "MIT"
  head "https://github.com/{github_repo}.git", branch: "main"

  depends_on "python@3.12"

  # Resource blocks for runtime dependencies are auto-generated by:
  #   brew update-python-resources Formula/{package}.rb
  # Do not hand-edit them.

  def install
    virtualenv_install_with_resources
  end

  test do
    # The CLI must report its version. Catches a virtualenv that built but
    # has no working entry point.
    assert_match version.to_s, shell_output("#{bin}/{entrypoint} --version")

    # If the tool has a no-side-effect dry-run / validate / status verb,
    # invoke it here so a broken default-config path fails `brew test`
    # before users hit it. Adjust per product:
    #
    #   assert_match "ok", shell_output("#{bin}/{entrypoint} doctor")
  end
end
