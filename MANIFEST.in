# sdist contents for get-installer. Hatchling reads the modern
# packaging-data declaration in pyproject.toml; this file is a
# belt-and-braces fallback for older tools that read MANIFEST.in.

include README.md
include SPEC.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include SECURITY.md
include pyproject.toml
include MANIFEST.in
include .editorconfig
include .gitignore
include registry.json
include Dockerfile
include docker-compose.yml
include .env.example

recursive-include src/get_installer *.py py.typed
recursive-include bootstrap *.sh *.ps1
recursive-include schemas *.json
recursive-include scripts *.py *.sh
recursive-include deploy *.conf *.md *.sh
recursive-include docs *.md
recursive-include tests *.py

# Exclude caches + builds + secrets: defence in depth on top of .gitignore
global-exclude *.pyc
global-exclude __pycache__
global-exclude .DS_Store
global-exclude *.swp
global-exclude *.swo
global-exclude *~
global-exclude .env
global-exclude .env.*
recursive-exclude dist *
recursive-exclude build *
recursive-exclude .venv *
recursive-exclude .mypy_cache *
recursive-exclude .pytest_cache *
recursive-exclude .ruff_cache *
